{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "overline-digital",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  // Les secrets (clés Supabase) ne vont JAMAIS ici en clair.
  // Configure-les avec :
  //   npx wrangler secret put SUPABASE_URL
  //   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
  // (ou via le dashboard Cloudflare > Workers > ton projet > Settings > Variables)
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://kmlmemumyzhszjqzwwfq.supabase.co"
  }
}
