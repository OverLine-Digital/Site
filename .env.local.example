# Copie ce fichier en .env.local et remplace par tes vraies valeurs
# Project Settings > API dans Supabase
# Utilise uniquement la clé PUBLISHABLE/ANON ici, jamais la clé secrète.

NEXT_PUBLIC_SUPABASE_URL=https://kmlmemumyzhszjqzwwfq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=colle_ta_publishable_key_ici

# Email de confirmation envoyé au client après soumission d'une demande.
# Crée un compte sur https://resend.com (gratuit jusqu'à 3000 emails/mois),
# vérifie ton domaine (ou utilise leur domaine de test le temps de configurer
# le tien), puis colle la clé API ici. Sans ces deux variables, le site
# fonctionne normalement mais aucun email de confirmation n'est envoyé.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=OverLine Digital <notifications@tondomaine.com>

# URL publique du site, utilisée pour construire le lien de suivi dans
# l'email de confirmation. Laisse vide pour utiliser le domaine par défaut.
NEXT_PUBLIC_SITE_URL=https://overlinedigital-b88.workers.dev

# Email de l'équipe qui reçoit une notification à chaque message laissé
# depuis le widget assistant (voir components/ai-assistant.tsx). Utilise le
# même compte Resend que ci-dessus. Sans cette variable, les messages sont
# quand même bien enregistrés en base (table assistant_messages) — tu ne
# reçois juste aucune alerte automatique et dois aller les consulter
# manuellement dans Supabase.
ADMIN_NOTIFICATION_EMAIL=overlinedigitall@gmail.com
